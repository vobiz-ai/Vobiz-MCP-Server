{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "vobiz",
  "version": "1.2.0",
  "description": "Vobiz calls, conferences, IVRs, call records, numbers, SIP trunks, sub-accounts, billing and SMS/MMS/RCS, plus the Vobiz Agent Skills.",
  "author": {
    "name": "Vobiz",
    "email": "support@vobiz.ai",
    "url": "https://www.vobiz.ai"
  },
  "homepage": "https://www.vobiz.ai/docs/resources/vobiz-mcp",
  "repository": "https://github.com/vobiz-ai/Vobiz-MCP-Server",
  "license": "MIT",
  "keywords": [
    "vobiz",
    "telephony",
    "voice-api",
    "sip-trunking",
    "sms",
    "rcs",
    "ivr",
    "voice-agents",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Vobiz",
        "shortDescription": "Run Vobiz calls, numbers, SIP and messaging from your agent",
        "developerName": "Vobiz",
        "category": "Developer Tools",
        "websiteURL": "https://www.vobiz.ai",
        "privacyPolicyURL": "https://www.vobiz.ai/privacy",
        "termsOfServiceURL": "https://www.vobiz.ai/terms",
        "defaultPrompt": [
          "Show my Vobiz balance and live calls.",
          "Build a VobizXML IVR: press 1 for sales, 2 for support."
        ]
      }
    }
  }
}
