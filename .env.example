# Vobiz MCP server — copy to .env (git-ignored) and fill in. PLACEHOLDERS ONLY: never put real
# credentials in this file. Use separate .env files (or secret stores) for development and production.

# ── Credentials (required) ── from https://console.vobiz.ai
VOBIZ_AUTH_ID=MA_XXXXXXXX
VOBIZ_AUTH_TOKEN=replace-with-your-auth-token

# development (default) | production (refuses a localhost API URL)
VOBIZ_ENV=development
VOBIZ_BASE_URL=https://api.vobiz.ai
VOBIZ_TIMEOUT_MS=15000
VOBIZ_LOG_LEVEL=info
VOBIZ_DEFAULT_PAGE_SIZE=20

# ── Outbound calling (off by default) ──
VOBIZ_ENABLE_CALLS=false
VOBIZ_DEFAULT_ANSWER_URL=https://your-host.example/answer
VOBIZ_VERIFY_CALLER_ID=true
# Destination country codes allowed, e.g. 91,1. Empty (default) = any country.
VOBIZ_ALLOWED_COUNTRY_CODES=
# Number prefixes never dialled (digits incl. country code), e.g. premium ranges
VOBIZ_BLOCKED_PREFIXES=
# Optional exact allowlists (E.164, comma-separated)
VOBIZ_ALLOWED_DESTINATIONS=
VOBIZ_ALLOWED_CALLER_IDS=
VOBIZ_MAX_CALL_DURATION_SEC=600
VOBIZ_MAX_CALLS_PER_MINUTE=5
VOBIZ_MAX_CALLS_PER_HOUR=30
VOBIZ_MAX_CONCURRENT_CALLS=3
VOBIZ_CHECK_BALANCE=true
VOBIZ_MIN_BALANCE=0
# Wallet used for the balance floor, e.g. INR or USD. Empty (default) = the account's primary wallet.
VOBIZ_BALANCE_CURRENCY=
# Identical calls (same from/to) inside this window are refused unless a new idempotency_key is given
VOBIZ_DUPLICATE_CALL_WINDOW_SEC=120
# Optional file to keep idempotency records across restarts
VOBIZ_IDEMPOTENCY_FILE=

# ── Account changes: numbers, trunks, applications (off by default) ──
VOBIZ_ENABLE_PROVISIONING=false
# Max first charge (setup + monthly fee) of one number purchase; 0 = purchases refused
VOBIZ_MAX_NUMBER_COST=0
VOBIZ_MAX_NUMBER_PURCHASES_PER_DAY=1

# ── SMS, MMS and RCS (off by default) ──
VOBIZ_ENABLE_MESSAGING=false
# Recipient country codes allowed, e.g. 1,44. Empty (default) = any country.
VOBIZ_MESSAGING_ALLOWED_COUNTRY_CODES=
VOBIZ_MAX_RECIPIENTS_PER_SEND=10
VOBIZ_MAX_MESSAGES_PER_MINUTE=20
VOBIZ_MAX_MESSAGES_PER_HOUR=200
# Check that an SMS/MMS sender is a messaging number on the account before sending
VOBIZ_VERIFY_SENDER=true

# ── Call-control URL hosts (answer/transfer/redirect/gather). Public URL + default answer URL hosts are added automatically.
VOBIZ_ALLOWED_URL_HOSTS=

# Accept answer/transfer/redirect URLs on any public https host (default false; the hosted connector sets true)
VOBIZ_ALLOW_ANY_URL_HOST=false

# ── Links shown to users (defaults are the public Vobiz URLs) ──
VOBIZ_CONSOLE_URL=https://console.vobiz.ai
VOBIZ_PRIVACY_URL=https://vobiz.ai/privacy
VOBIZ_DOCS_URL=https://vobiz.ai/docs/resources/account-mcp
VOBIZ_DOCS_MCP_URL=https://www.vobiz.ai/docs/mcp

# ── Single-account HTTP mode (npm run start:http) ──
PORT=3000
# 32-128 chars [A-Za-z0-9_-]; part of the connector URL. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VOBIZ_HTTP_SECRET=
# Public https base URL of this server (tunnel / domain); enables hosted flows, gather and webhooks
VOBIZ_PUBLIC_URL=
# Expose call-acting tools over HTTP (default false = read-only)
VOBIZ_REMOTE_ALLOW_CALLS=false
# require (default) | verify_if_present | off — X-Vobiz-Signature-V3/V2 on callbacks
VOBIZ_WEBHOOK_SIGNATURE=require
VOBIZ_ANSWER_TEXT=Connecting your call via Vobiz operational MCP.

# ── Hosted multi-tenant connector (npm run start:hosted / Docker) ──
# Every user signs in with their own Auth ID + Auth Token through OAuth; VOBIZ_AUTH_ID/TOKEN above are ignored.
# Public https base URL of this deployment; the MCP endpoint is <VOBIZ_HOSTED_URL>/mcp
VOBIZ_HOSTED_URL=
# >= 32 random characters, identical on every replica and stable across restarts (rotating it signs everyone out)
VOBIZ_HOSTED_SECRET=
VOBIZ_ACCESS_TOKEN_TTL_SEC=3600
VOBIZ_REFRESH_TOKEN_TTL_SEC=2592000
# Hosts allowed to serve OAuth Client ID Metadata Documents (comma-separated)
VOBIZ_CIMD_HOSTS=claude.ai
# Browser origins allowed to call /mcp (requests without an Origin header are always allowed)
VOBIZ_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
# Tools the hosted connector never offers (default: purchases and callback-hosting tools). Empty = offer all.
# VOBIZ_HOSTED_EXCLUDED_TOOLS=buy_phone_number,gather_dtmf,get_gather_result,list_webhook_events,hold_call,unhold_call
